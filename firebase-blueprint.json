{
  "entities": {
    "admins": {
      "title": "Admins",
      "description": "Administrator accounts with scrypt-hashed passwords and role metadata",
      "type": "object",
      "properties": {
        "username": { "type": "string", "minLength": 3, "maxLength": 32 },
        "passwordHash": { "type": "string" },
        "role": { "type": "string" },
        "active": { "type": "boolean" },
        "mustChangePassword": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["username", "passwordHash", "role", "active"]
    },
    "users": {
      "title": "Users",
      "description": "User accounts, scrypt password hashes, status, and pass verification flags",
      "type": "object",
      "properties": {
        "username": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-zA-Z0-9_-]{3,32}$" },
        "passwordHash": { "type": "string" },
        "tier": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "passVerificationRequired": { "type": "boolean" },
        "passVerified": { "type": "boolean" },
        "hwidMatched": { "type": "boolean" },
        "protocol": { "type": "string" },
        "verifiedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["username", "passwordHash", "tier", "status"]
    },
    "user_status": {
      "title": "User Status Projection",
      "description": "Non-sensitive live synchronization projection of user account status and pass verification state",
      "type": "object",
      "properties": {
        "username": { "type": "string", "minLength": 3, "maxLength": 32 },
        "tier": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "passVerificationRequired": { "type": "boolean" },
        "passVerified": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["username", "status", "passVerificationRequired", "passVerified"]
    },
    "user_configs": {
      "title": "User Configurations",
      "description": "User cheat features, aim parameters and ESP settings stored in Firestore",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "aimbot": { "type": "boolean" },
        "aimbotRage": { "type": "boolean" },
        "aimbotSilent": { "type": "boolean" },
        "silentTarget": { "type": "string" },
        "aimFov": { "type": "number" },
        "headshotRate": { "type": "number" },
        "safeMode": { "type": "boolean" },
        "espState": { "type": "object" },
        "configState": { "type": "object" },
        "selectedMode": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["username"]
    },
    "session_logs": {
      "title": "Session Logs",
      "description": "Connection handshake and security session logs",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "node": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["username", "timestamp"]
    },
    "verification_codes": {
      "title": "Verification Codes",
      "description": "Pass verification code records assigned to users with usage limits and expiry",
      "type": "object",
      "properties": {
        "codeHash": { "type": "string" },
        "codeCipher": { "type": "string" },
        "codeLabel": { "type": "string" },
        "targetUser": { "type": "string" },
        "used": { "type": "boolean" },
        "usedCount": { "type": "number" },
        "maxUses": { "type": "number" },
        "usedBy": { "type": "string" },
        "usedAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "active": { "type": "boolean" },
        "amount": { "type": "number" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "revokedAt": { "type": "string" }
      },
      "required": ["codeHash", "used", "active", "targetUser"]
    },
    "admin_logs": {
      "title": "Admin Logs",
      "description": "Audit trail of admin authentication, user management, and verification code actions",
      "type": "object",
      "properties": {
        "actor": { "type": "string" },
        "action": { "type": "string" },
        "target": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["actor", "action", "timestamp"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/admins" },
      "description": "Administrator credentials and role flags"
    },
    "/users/{username}": {
      "schema": { "$ref": "#/entities/users" },
      "description": "Global user accounts managed by admin"
    },
    "/user_status/{username}": {
      "schema": { "$ref": "#/entities/user_status" },
      "description": "Non-sensitive user status and pass verification sync documents"
    },
    "/user_configs/{username}": {
      "schema": { "$ref": "#/entities/user_configs" },
      "description": "Per-user feature preferences"
    },
    "/session_logs/{logId}": {
      "schema": { "$ref": "#/entities/session_logs" },
      "description": "User connection audit logs"
    },
    "/verification_codes/{codeHash}": {
      "schema": { "$ref": "#/entities/verification_codes" },
      "description": "SHA-256 hashed pass verification codes"
    },
    "/admin_logs/{logId}": {
      "schema": { "$ref": "#/entities/admin_logs" },
      "description": "Admin audit trail events"
    }
  }
}
